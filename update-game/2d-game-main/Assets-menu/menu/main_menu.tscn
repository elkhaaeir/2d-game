[sub_resource type="GDScript" id="GDScript_f5okj"]
script/source = "extends Control
@onready var main_menu: VBoxContainer = $MainMenu
@onready var options: Panel = $Options
@onready var start_menu: Panel = $StartMenu
@onready var chapter_select: Panel = $ChapterSelect

func _ready() -> void:
	_show_main_menu()
	$StartMenu/VBoxContainer2/VBoxContainer/Continue.disabled = not ProgressManager.has_progress()

func _show_main_menu() -> void:
	main_menu.visible = true
	start_menu.visible = false
	options.visible = false
	chapter_select.visible = false

func _refresh_chapter_buttons() -> void:
	$ChapterSelect/VBoxContainer/Chapter2.disabled = not ProgressManager.is_chapter_unlocked(2)
	$ChapterSelect/VBoxContainer/Chapter3.disabled = not ProgressManager.is_chapter_unlocked(3)
	$ChapterSelect/VBoxContainer/Chapter4.disabled = not ProgressManager.is_chapter_unlocked(4)

func _on_start_button_pressed() -> void:
	main_menu.visible = false
	start_menu.visible = true

func _on_option_button_pressed() -> void:
	main_menu.visible = false
	options.visible = true

func _on_exit_button_pressed() -> void:
	get_tree().quit()

func _on_return_button_pressed() -> void:
	_show_main_menu()

func _on_return_menu_pressed() -> void:
	_show_main_menu()

func _on_new_game_pressed() -> void:
	ProgressManager.reset_progress()
	get_tree().change_scene_to_file(\"res://Assets-gameplay/Scenes-gameplay/Areas/areas_1.tscn\")

func _on_continue_pressed() -> void:
	if not ProgressManager.has_progress():
		return
	start_menu.visible = false
	chapter_select.visible = true
	_refresh_chapter_buttons()

func _start_chapter(chapter: int, scene_path: String) -> void:
	if not ProgressManager.is_chapter_unlocked(chapter):
		return
	get_tree().change_scene_to_file(scene_path)

func _on_chapter_1_pressed() -> void:
	_start_chapter(1, \"res://Assets-gameplay/Scenes-gameplay/Areas/areas_1.tscn\")

func _on_chapter_2_pressed() -> void:
	_start_chapter(2, \"res://Assets-gameplay/Scenes-gameplay/Areas/areas_2.tscn\")

func _on_chapter_3_pressed() -> void:
	_start_chapter(3, \"res://Assets-gameplay/Scenes-gameplay/Areas/area_3.tscn\")

func _on_chapter_4_pressed() -> void:
	_start_chapter(4, \"res://Assets-gameplay/Scenes-gameplay/Areas/area_4.tscn\")

func _on_chapter_back_pressed() -> void:
	chapter_select.visible = false
	start_menu.visible = true
"

